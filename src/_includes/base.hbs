{{!-- Absolute minimum template for every page --}}

<!DOCTYPE html>
<html lang="en">

<head>
    {{!-- CSS --}}
    <link rel="stylesheet" href="/css/style.css?v={{pkg.version}}">
    
    {{#each css}}<link rel="stylesheet" href="{{this}}">{{/each}}

    {{!-- JS --}}
    {{#each scripts}}
    {{#if inline}}
    <script>{{{inline}}}</script>
    {{else}}
    <script src="{{src}}?v={{pkg.version}}"{{#if defer}} defer{{/if}}></script>
    {{/if}}
    {{/each}}
    
    <title>{{ title }} &ndash; SJP</title>
    <meta name="title" content="{{#if meta.title}}{{meta.title}}{{else}}{{title}} &ndash; SJP{{/if}}">

    <meta charset="UTF-8">
    <meta name="author" content="{{meta.author}}">
    <meta name="keywords" content="{{meta.keywords}}">
    <meta name="description" content="{{meta.desc}}">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <meta property="og:type" content="website">
    <link rel="manifest" href="/site.webmanifest">
</head>

<body>
  {{{ content }}}
</body>
</html>